# API Keys - Replace with your actual keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
REPLICATE_API_TOKEN=r8-your-replicate-token-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here
RUNWAY_API_KEY=your-runway-key-here

# YouTube API
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# Database
DATABASE_URL=sqlite:///data/database/automation.db

# System Settings
LOG_LEVEL=INFO
MAX_CONCURRENT_GENERATIONS=5
DEFAULT_RETRY_ATTEMPTS=3
DEFAULT_RETRY_DELAY=2

# Cost Controls (USD)
GLOBAL_DAILY_COST_CAP=50.00
GLOBAL_MONTHLY_COST_CAP=1000.00

# Storage
ASSET_STORAGE_PATH=data/assets
CHANNEL_CONFIG_PATH=config/channels.yaml
