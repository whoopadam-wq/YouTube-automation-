# AI Provider API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Kie.ai - Universal AI Provider (REQUIRED for video/image generation)
# Get your key from kie.ai dashboard
KIEAI_API_KEY=74ba78915402a077bb93b3cf140eb904

# Legacy providers (optional, kie.ai preferred)
REPLICATE_API_TOKEN=r8_your-token-here
ELEVENLABS_API_KEY=your-key-here

# Research & Web Scraping (Optional - enables viral content research)
SERPER_API_KEY=your-serper-api-key  # Get free key at serper.dev
ENABLE_RESEARCH=true  # Set to false to disable research phase

# Platform Posting Credentials (Optional)
YOUTUBE_CLIENT_SECRETS=/path/to/client_secrets.json
TIKTOK_ACCESS_TOKEN=your-tiktok-token
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_ACCOUNT_ID=your-account-id

# Studio Settings
PORT=3000
STUDIO_MOCK_GENERATION=true  # Set to false for real generation
STUDIO_MOCK_POSTING=true     # Set to false for real posting
